{
  "manifest_version": 3,
  "name": "cpeasy",
  "version": "1.0",
  "description": "Embeds a LeetCode-style split-screen IDE directly inside Codeforces problem pages with dynamic code state synchronization.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://codeforces.com/*",
    "*://*.codeforces.com/*",
    "https://wandbox.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ],
      "css": [
        "css/styles.css",
        "lib/codemirror.min.css",
        "lib/material.min.css"
      ],
      "js": [
        "lib/codemirror.min.js",
        "lib/clike.min.js",
        "lib/python.min.js",
        "lib/javascript.js",
        "lib/rust.js",
        "lib/go.js",
        "js/config.js",
        "js/utils.js",
        "js/autofill.js",
        "js/ide.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "*.wasm"
      ],
      "matches": [
        "https://codeforces.com/*"
      ]
    }
  ]
}